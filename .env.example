# Copy to .env and fill in. NEVER commit .env.
# The offline dry-run pipeline needs NONE of these. Live runs need the X + LLM +
# Turso blocks. These are the SAME names the GitHub Actions workflows expect as
# repo secrets (Settings > Secrets and variables > Actions).

# --- X / Twitter API (pay-per-use). OAuth 1.0a user context. ---
# developer.x.com > your app > "Keys and tokens". App must have Read+Write
# permissions BEFORE you generate the access token pair (regenerate if not).
X_API_KEY=                 # "API Key" (consumer key)
X_API_SECRET=              # "API Key Secret" (consumer secret)
X_ACCESS_TOKEN=            # "Access Token" for the bot's own account
X_ACCESS_TOKEN_SECRET=     # "Access Token Secret"
X_USER_ID=                 # numeric id of the bot account (GET /2/users/me)

# --- LLM (judge + commentary). config.yaml llm.provider selects which. ---
ANTHROPIC_API_KEY=         # console.anthropic.com  (current provider: anthropic)
GROQ_API_KEY=              # console.groq.com free tier (only if llm.provider: groq)
GEMINI_API_KEY=            # aistudio.google.com   (only if llm.provider: gemini)
XAI_API_KEY=               # console.x.ai, paid    (only if llm.provider: xai)
OPENAI_API_KEY=            # embeddings only (dedup / idea clustering)

# --- Web-search discovery (weekly account finder) ---
# Brave Search API — brave.com/search/api (2,000 queries/mo free).
# Only used by `xbot list-sync` when listsync.discovery_mode: web.
SEARCH_API_KEY=

# --- Storage: Turso for remote/shared state; unset = local SQLite in data/ ---
# `turso db show <name> --url` and `turso db tokens create <name>`
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Curator / Strategist agents (headless Claude Code in CI) ---
# `claude setup-token` on a machine logged in to Claude. GitHub secret only;
# not needed locally where you are already logged in.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Ops ---
REPORT_WEBHOOK=            # optional: Slack/Discord webhook for daily report
